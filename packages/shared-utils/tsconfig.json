{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "src",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "paths": {
      "@emacare/shared-utils": ["./src/index"],
      "@emacare/shared-utils/common": ["./src/common/index"],
      "@emacare/shared-utils/types": ["./src/types/index"],
      "@emacare/shared-utils/assets": ["./src/assets/index"],
      "@emacare/shared-utils/asset": ["./src/assets/index"],
      "@emacare/shared-utils/rabbitmq": ["./src/rabbitmq"],
      "@emacare/shared-utils/middleware": ["./src/middleware/index"],
      "@emacare/mongo": ["../../packages/database/mongodb/dist/index"],
      "@emacare/mongo/types": ["../../packages/database/mongodb/dist/types/index"],
      "@emacare/mongo/models": ["../../packages/database/mongodb/dist/models/index"],
      "@emacare/mongo/repository": ["../../packages/database/mongodb/dist/repository"],
      "@emacare/mongo/*": ["../../packages/database/mongodb/dist/*"],
      "@emacare/prisma": ["../../packages/database/prisma/dist/index"],
      "@emacare/prisma/*": ["../../packages/database/prisma/dist/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
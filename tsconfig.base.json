{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "paths": {
      "@emacare/shared-utils": ["./packages/shared-utils/src/index"],
      "@emacare/shared-utils/common": ["./packages/shared-utils/src/common/index"],
      "@emacare/shared-utils/types": ["./packages/shared-utils/src/types/index"],
      "@emacare/shared-utils/assets": ["./packages/shared-utils/src/assets/index"],
      "@emacare/shared-utils/asset": ["./packages/shared-utils/src/assets/index"],
      "@emacare/shared-utils/middleware": ["./packages/shared-utils/src/middleware/index"],
      "@emacare/shared-utils/*": ["./packages/shared-utils/src/*"],
      "@emacare/mongo": ["./packages/database/mongodb/src/index"],
      "@emacare/mongo/types": ["./packages/database/mongodb/src/types/index"],
      "@emacare/mongo/models": ["./packages/database/mongodb/src/models/index"],
      "@emacare/mongo/repository": ["./packages/database/mongodb/src/repository"],
      "@emacare/mongo/*": ["./packages/database/mongodb/src/*"],
      "@emacare/prisma": ["./packages/database/prisma/src/index"],
      "@emacare/prisma/*": ["./packages/database/prisma/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "**/dist/**", "**/node_modules/**"]
}
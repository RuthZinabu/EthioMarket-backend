# API Gateway
API_GATEWAY_PORT=3000

# Auth Service
AUTH_SERVICE_PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-this

# Product Service
PRODUCT_SERVICE_PORT=3002
PRODUCT_SERVICE_URL=http://localhost:3002

# Order Service
ORDER_SERVICE_PORT=3003
ORDER_SERVICE_URL=http://localhost:3003

# Cart Service
CART_SERVICE_PORT=3004
CART_SERVICE_URL=http://localhost:3004
REDIS_URL=redis://localhost:6379

# Payment Service
PAYMENT_SERVICE_PORT=3005
PAYMENT_SERVICE_URL=http://localhost:3005
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key

# Shipping Service
SHIPPING_SERVICE_PORT=3006
SHIPPING_SERVICE_URL=http://localhost:3006
DHL_API_KEY=your-dhl-api-key
DHL_API_URL=https://apis-sandbox.dhl.com

# Notification Service
NOTIFICATION_SERVICE_PORT=3007
NOTIFICATION_SERVICE_URL=http://localhost:3007
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Database
MONGODB_URI=mongodb://localhost:27017/emacare
MONGODB_USER=admin
MONGODB_PASSWORD=password

# Environment
NODE_ENV=development
LOG_LEVEL=debug
